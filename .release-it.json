{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm lint",
      "pnpm format:check",
      "pnpm run typecheck",
      "pnpm run test:installed"
    ],
    "after:bump": "git add CHANGELOG.md"
  },
  "plugins": {
    "release-it-changelogen": {
      "from": "a433f6f6f71a329d5ba437c50fbbba2e59c9dfa8",
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true
  }
}
