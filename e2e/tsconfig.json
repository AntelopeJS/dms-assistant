{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "paths": {},
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": ["*.ts", "builder/*.ts", "**/*.mjs"],
  "exclude": [
    "playground",
    "builder/playground",
    "**/playwright-report*",
    "**/test-results*",
    "**/blob-report*"
  ]
}
