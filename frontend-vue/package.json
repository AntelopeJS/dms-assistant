{
	"name": "@antelopejs/dms-assistant-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.6.5",
	"engines": {
		"@antelopejs/dms-frontend": ">=0.10.0 <0.11.0"
	},
	"scripts": {
		"build": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" build",
		"typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
		"typecheck:chat": "vue-tsc --noEmit -p tsconfig.chat.json",
		"verify-source": "ajs dms verify-source --layer \"$PWD/node_modules/@antelopejs/dms/frontend-vue\" --module \"$PWD\"",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"test": "vitest run --passWithNoTests && vitest run --config builder/vitest.config.ts"
	},
	"dependencies": {
		"@antelopejs/interface-dms": ">=0.12.0 <1.0.0",
		"@inertiajs/vue3": "^3.7.0",
		"@types/markdown-it": "^14.1.2",
		"dompurify": "^3.2.4",
		"markdown-it": "^14.1.0",
		"vue": "^3.5.18",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@antelopejs/core": "1.21.0",
		"@antelopejs/dms": "file:../.tgz-deps/antelopejs-dms-41d2eb4.tgz",
		"@antelopejs/dms-frontend": ">=0.10.4 <1.0.0",
		"@antelopejs/interface-api": ">=0.3.0 <1.0.0",
		"@antelopejs/interface-api-util": ">=0.3.0 <1.0.0",
		"@antelopejs/interface-data-api": ">=0.6.1 <1.0.0",
		"@antelopejs/interface-database": ">=0.3.1 <1.0.0",
		"@antelopejs/interface-database-decorators": ">=0.2.1 <1.0.0",
		"@eslint/js": "^9.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vitest/runner": "^4.1.5",
		"@vue/compiler-sfc": "^3.5.18",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^9.0.0",
		"eslint-plugin-vue": "^10.0.0",
		"globals": "^16.0.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.0.0",
		"vite": "^7.3.2",
		"vitest": "^4.1.8",
		"vue-tsc": "^3.1.1"
	},
	"pnpm": {
		"overrides": {
			"@antelopejs/dms": "file:../.tgz-deps/antelopejs-dms-41d2eb4.tgz",
			"@antelopejs/dms>@antelopejs/interface-api": "0.3.2",
			"@antelopejs/dms>@antelopejs/interface-api-util": "0.3.2",
			"@antelopejs/dms>@antelopejs/interface-data-api": "0.6.3",
			"@antelopejs/dms>@antelopejs/interface-database": "0.3.1",
			"@antelopejs/dms>@antelopejs/interface-database-decorators": "0.3.2",
			"@antelopejs/interface-dms-builder": "file:../.tgz-deps/antelopejs-interface-dms-builder-41d2eb4.tgz",
			"@antelopejs/interface-dms": "file:../.tgz-deps/antelopejs-interface-dms-41d2eb4.tgz"
		}
	}
}
