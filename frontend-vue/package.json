{
	"name": "@antelopejs/dms-assistant-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"@antelopejs/dms-frontend": ">=0.11.8 <0.12.0"
	},
	"scripts": {
		"build": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" build",
		"typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
		"typecheck:chat": "vue-tsc --noEmit -p tsconfig.chat.json",
		"typecheck:tests": "vue-tsc --noEmit -p tsconfig.tests.json | grep -v '^\\(\\.\\./\\)*node_modules/'; test $? -eq 1",
		"verify-source": "ajs dms verify-source --layer \"$PWD/node_modules/@antelopejs/dms/frontend-vue\" --module \"$PWD\"",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check . && node --input-type=module -e \"import { assertDmsComponents } from '@antelopejs/dms/checks/dms-components'; await assertDmsComponents({ layer: '.', sources: ['../src'] });\"",
		"lint:fix": "eslint . --fix && prettier --write .",
		"test": "vitest run --passWithNoTests && vitest run --config builder/vitest.config.ts"
	},
	"dependencies": {
		"@antelopejs/interface-dms": ">=0.17.0 <0.18.0",
		"@inertiajs/vue3": "^3.7.0",
		"@types/markdown-it": "^14.1.2",
		"dompurify": "^3.2.4",
		"markdown-it": "^14.1.0",
		"vue": "^3.5.18",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@antelopejs/core": ">=1.24.6 <1.25.0",
		"@antelopejs/dms": ">=0.24.0 <0.25.0",
		"@antelopejs/dms-frontend": ">=0.11.8 <0.12.0",
		"@antelopejs/interface-api": ">=0.3.4 <0.4.0",
		"@antelopejs/interface-api-util": ">=0.3.3 <0.4.0",
		"@antelopejs/interface-data-api": ">=0.8.2 <0.9.0",
		"@antelopejs/interface-database": ">=0.4.3 <0.5.0",
		"@antelopejs/interface-database-decorators": ">=0.5.4 <0.6.0",
		"@antelopejs/tooling-configs": "^0.10.11",
		"@nuxt/eslint-config": "^1.2.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vitest/runner": "^4.1.5",
		"@vue/compiler-sfc": "^3.5.18",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^10.4.0",
		"jsdom": "^31.0.0",
		"ofetch": "^1.4.1",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"typescript": "^7.0.0",
		"vite": "^7.3.2",
		"vitest": "^4.1.8",
		"vue-i18n": "^11.1.12",
		"vue-tsc": "^3.1.1"
	}
}
