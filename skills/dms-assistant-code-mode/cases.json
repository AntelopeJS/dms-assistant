{
  "version": 1,
  "cases": [
    {
      "id": "dms-assistant-code-mode-edit-loop",
      "area": "dms-assistant",
      "style": "clean",
      "prompt": "The assistant is in Code mode and I want it to change the orders page and the two other pages that reuse the same custom block. How should it work so I can watch each page update in the dashboard?",
      "expect": {
        "skills": ["dms-assistant-code-mode"],
        "acceptable": ["dms-assistant", "dms-pages", "dms-best-practices"],
        "mustMention": ["find_pages_using", "navigate_to_page", "typecheck"]
      }
    },
    {
      "id": "dms-assistant-code-mode-page-404-casual",
      "area": "dms-assistant",
      "style": "casual",
      "prompt": "ai edited my page in code mode and now it 404s, how do i see why",
      "expect": {
        "skills": ["dms-assistant-code-mode"],
        "acceptable": ["dms-assistant", "dms-pages", "dms"],
        "mustMention": ["query_logs"]
      }
    },
    {
      "id": "dms-assistant-code-mode-not-safe-builder",
      "area": "dms-assistant",
      "style": "clean",
      "prompt": "We are in safe mode. Create a Reports page under the pages.reports category with builder_create_page, then add a TableView on the orders resource.",
      "expect": {
        "skills": ["dms-builder-mcp"],
        "acceptable": ["dms-pages", "dms-best-practices"],
        "avoid": ["dms-assistant-code-mode"]
      }
    }
  ]
}
